# Instance rieng cua CourseGraph. Khong dung database dang co cho test/reset.
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
NEO4J_URI=bolt://127.0.0.1:17687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=coursegraph
# Thong tin hien thi cho ADMIN; khong tu suy doan Desktop tu port.
NEO4J_DEPLOYMENT=standalone
NEO4J_BROWSER_URL=http://127.0.0.1:17474/browser/
NEO4J_TEST_DATABASE=coursegraph-test
JWT_SECRET=
JWT_TTL_SECONDS=3600
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
BACKUP_DIR=backups
COOKIE_SECURE=false
